#!/bin/sh
# Git pre-push hook: never push code that fails the test suite.
# Installed by `npm run hooks:install` (sets core.hooksPath to .githooks).
#
# Uses `node` directly instead of `npm` so it works from Git Bash on Windows,
# where the extensionless npm shim can resolve to the WSL bash launcher.

echo ""
echo "Running pre-push checks..."
echo ""

if [ ! -d node_modules/vitest ]; then
    echo "PUSH ABORTED: dependencies are not installed. Run 'npm install' first."
    exit 1
fi

if ! node --check server.js; then
    echo ""
    echo "PUSH ABORTED: server.js has a syntax error."
    exit 1
fi

if ! node node_modules/vitest/vitest.mjs run; then
    echo ""
    echo "=============================================="
    echo " PUSH ABORTED: tests failed."
    echo " Fix the errors above and push again."
    echo " Run 'npm test' for the full output."
    echo "=============================================="
    echo ""
    exit 1
fi

echo ""
echo "Pre-push checks passed."
